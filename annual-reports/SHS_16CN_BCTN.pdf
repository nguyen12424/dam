   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">A television screen on the floor of the New York Stock Exchange shows the decision of the Federal Reserve, Wednesday, July 29, 2015. The Federal Reserve appears on track to raise interest rates later this year but is signaling that it wants to see further economic gains and higher inflation before doing so. (AP Photo/Richard Drew)</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Financial Markets Wall Street Federal Reserve</rdf:li>
    </rdf:Alt>
   </dc:title>
